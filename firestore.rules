rules_version = '2';

// Who can read and write what in the family's Firestore database (Firebase
// project Bloxx). Publish this in the Firebase console: Firestore Database >
// Rules > paste this whole file > Publish.
//
// In plain words:
// - Nobody can do anything without signing in.
// - Signing in is not enough: the account's email must be on the family list
//   (collection "family", one document per email, added by hand in the console).
//   Anyone on the internet can create an account, but only family members get in.
// - Each family member can read and write only their own backup (users/{their id}).
// - Every family member can read the family leaderboard and everyone's list of
//   games played, but can only write their own row and their own list.
// - The family list itself can only be changed in the console.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isFamily() {
      return signedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/family/$(request.auth.token.email.lower()));
    }

    function isMe(uid) {
      return request.auth.uid == uid;
    }

    function isName(v) {
      return v is string && v.size() > 0 && v.size() <= 16;
    }

    // The family list: document id = a family member's email, in lowercase.
    // A signed-in person may check their own entry; nobody may change the list from the app.
    match /family/{email} {
      allow read: if signedIn() && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // One backup per person: their name, top 10 scores and saved game.
    match /users/{uid} {
      allow read: if isFamily() && isMe(uid);
      allow create, update: if isFamily() && isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'scores', 'game', 'gameAt', 'updatedAt'])
        && isName(request.resource.data.name)
        && request.resource.data.scores is list && request.resource.data.scores.size() <= 10
        && (request.resource.data.game == null
            || (request.resource.data.game is string && request.resource.data.game.size() < 20000))
        && request.resource.data.gameAt is number
        && request.resource.data.updatedAt is number;
      allow delete: if isFamily() && isMe(uid);
    }

    // The family leaderboard: one row per person with their best score.
    match /leaderboard/{uid} {
      allow read: if isFamily();
      allow create, update: if isFamily() && isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'best', 'level', 'date', 'updatedAt'])
        && isName(request.resource.data.name)
        && request.resource.data.best is int && request.resource.data.best >= 0 && request.resource.data.best < 100000000
        && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 10
        && request.resource.data.date is number
        && request.resource.data.updatedAt is number;
      allow delete: if isFamily() && isMe(uid);
    }

    // Every game one person played (start, end, points, levels), at most 500.
    // The whole family can read it, so the game list shows everyone.
    match /history/{uid} {
      allow read: if isFamily();
      allow create, update: if isFamily() && isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'games', 'updatedAt'])
        && isName(request.resource.data.name)
        && request.resource.data.games is list && request.resource.data.games.size() <= 500
        && request.resource.data.updatedAt is number;
      allow delete: if isFamily() && isMe(uid);
    }

    // Anything else is closed.
  }
}
